# Field Theory local development
#
# Copy to .env or export values in your shell when you need overrides.
# Do not commit real tokens, cookies, OAuth credentials, wallet keys, or
# deployment secrets.

# Optional path overrides for isolated local testing.
FT_DATA_DIR=
FT_LIBRARY_DIR=
FT_COMMANDS_DIR=

# Optional CLI binary override used by Raycast and wrappers.
FT_CLI_BIN=ft

# Optional model routing. Default CLI behavior uses logged-in Claude/Codex
# sessions unless API mode is explicitly configured.
FT_ENGINE_AUTH_MODE=cli

# Optional X API mode. Normal `ft sync` uses browser session cookies and does
# not require these.
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Future hosted suite variables. These are intentionally unused until the
# capture-first local contracts ship.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GORDO_TEMPLATE_REPO=chipoto69/Gordo
NEXT_PUBLIC_BASE_CHAIN_ID=8453
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
