# Field Theory local development
#
# Copy to .env or export values in your shell when you need overrides.
# Do not commit real tokens, cookies, OAuth credentials, wallet keys, or
# deployment secrets.

# Optional path overrides for isolated local testing.
FT_DATA_DIR=
FT_LIBRARY_DIR=
FT_COMMANDS_DIR=

# Optional CLI binary override used by Raycast and wrappers.
FT_CLI_BIN=ft

# Optional model routing. Default CLI behavior uses logged-in Claude/Codex
# sessions unless API mode is explicitly configured.
FT_ENGINE_AUTH_MODE=cli

# Optional X API mode. Normal `ft sync` uses browser session cookies and does
# not require these.
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Hosted suite variables. The portal fails closed when Privy server auth is
# absent. Keep development-only bypasses disabled outside tests.
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
PRIVY_DEV_ALLOW_UNSIGNED=false
# Required for hosted production mutations. Run
# `npm --prefix apps/portal run db:migrate` against this URL before deploy.
DATABASE_URL=
FIELD_THEORY_AUDIT_STORE=
# Local/test only; production ignores this when DATABASE_URL is absent.
FIELD_THEORY_PORTAL_ALLOW_MEMORY_STORE=false
# Local bootstrap convenience. Keep false in production; use db:migrate.
FIELD_THEORY_PORTAL_AUTO_CREATE_SCHEMA=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GORDO_TEMPLATE_REPO=chipoto69/Gordo
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
X402_ENABLED=false
X402_FACILITATOR_URL=
X402_RECEIVING_ADDRESS=
